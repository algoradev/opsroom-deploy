# OpsRoom — environment contract (reports/141 in the product repo).
#
# EVERY VALUE HERE IS INERT. Nothing works until install.sh (or you)
# fills it in — that is deliberate: this repo is public, and a working
# default in a public file is a shipped compromise. The installer
# generates every secret below with `openssl rand`; you only ever type
# what the setup form asks for.
#
# The product pin (OPSROOM_TAG / OPSROOM_REGISTRY) is NOT here — it lives
# in release.env (tracked, moved by upgrades). Override OPSROOM_TAG in
# your local .env only to roll back; the installer warns when you do.

# ── set by the installer from the tailnet ────────────────────────────
TAILSCALE_HOST=
OPSROOM_PUBLIC_ORIGIN=

# ── identity plane: postgres superuser + per-service roles ───────────
# (generated by install.sh; the postgres init creates the roles on first
# boot — see config/postgres-init/)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_NAME=asunset
APP_DB_OWNER=asunset_owner
APP_DB_OWNER_PASSWORD=
APP_DB_USER=asunset
APP_DB_PASSWORD=
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=
FGA_DB_NAME=openfga
FGA_DB_USER=openfga
FGA_DB_PASSWORD=

# ── keycloak + openfga ───────────────────────────────────────────────
KEYCLOAK_REALM=asunset
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_API_CLIENT_SECRET=
OPENFGA_API_KEY=

# ── product ──────────────────────────────────────────────────────────
OPSROOM_PG_PASSWORD=
# Auth is ENFORCED from first boot (the api's lifespan bootstraps the
# authorization store only when enforcing — a stack that boots with this
# off never wires its identity plane).
OPSROOM_AUTH_ENFORCE=true
# Instance bootstrap answers (the setup form fills these):
OPSROOM_ORG=
OPSROOM_PROJECT=
OPSROOM_TEAM=
INVITE_DELIVERY=temp_password

# ── backups (the form asks; strongly recommended) ────────────────────
OPSROOM_BACKUP_DEST=

# ── optional: SMTP for emailed invites/resets ────────────────────────
KC_SMTP_HOST=
KC_SMTP_PORT=
KC_SMTP_FROM=
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# ── misc ─────────────────────────────────────────────────────────────
VECTOR_LOG_LEVEL=info
MCP_BEARER=
