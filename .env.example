# OpsRoom — environment contract (reports/141 in the product repo).
#
# EVERY VALUE HERE IS INERT. Nothing works until install.sh (or you)
# fills it in — that is deliberate: this repo is public, and a working
# default in a public file is a shipped compromise. The installer
# generates every secret below with `openssl rand`; you only ever type
# what the setup form asks for.
#
# The product pin (OPSROOM_TAG / OPSROOM_REGISTRY) is NOT here — it lives
# in release.env (tracked, moved by upgrades). Override OPSROOM_TAG in
# your local .env only to roll back; the installer warns when you do.

# ── set by the installer from the tailnet ────────────────────────────
TAILSCALE_HOST=
OPSROOM_PUBLIC_ORIGIN=

# ── identity plane: postgres superuser + per-service roles ───────────
# (generated by install.sh; the postgres init creates the roles on first
# boot — see config/postgres-init/)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_NAME=asunset
APP_DB_OWNER=asunset_owner
APP_DB_OWNER_PASSWORD=
APP_DB_USER=asunset
APP_DB_PASSWORD=
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=
FGA_DB_NAME=openfga
FGA_DB_USER=openfga
FGA_DB_PASSWORD=

# ── keycloak + openfga ───────────────────────────────────────────────
KEYCLOAK_REALM=asunset
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_API_CLIENT_SECRET=
OPENFGA_API_KEY=

# ── product ──────────────────────────────────────────────────────────
OPSROOM_PG_PASSWORD=
# Auth is ENFORCED from first boot (the api's lifespan bootstraps the
# authorization store only when enforcing — a stack that boots with this
# off never wires its identity plane).
OPSROOM_AUTH_ENFORCE=true
# Instance bootstrap answers (the setup form fills these):
OPSROOM_ORG=
OPSROOM_PROJECT=
OPSROOM_TEAM=
INVITE_DELIVERY=temp_password

# ── backups (the form asks; strongly recommended) ────────────────────
OPSROOM_BACKUP_DEST=

# ── optional: SMTP for emailed invites/resets ────────────────────────
KC_SMTP_HOST=
KC_SMTP_PORT=
KC_SMTP_FROM=
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# ── the boot trio (product board 150, D9) ────────────────────────────
# A production image REFUSES to start unless each of these is set.
# install.sh mints the first two and writes the third from the form;
# `install.sh --upgrade` appends the two mintable ones to an older .env
# and stops on a missing OPSROOM_BACKUP_DEST.
#
# ONLY ONE OF THE THREE HAS AN OFF SWITCH. OPSROOM_BACKUP_DEST accepts
# `none` as a deliberate declaration. The other two do not:
#   SESSION_TOKEN_PRIVATE_KEY_B64 — RSA-2048 PEM, base64 on ONE line.
#     Minted ONCE per instance; a new key logs every agent session out.
#   MCP_BEARER — the agent door's shared secret, and `none` is REFUSED BY
#     NAME in every environment (D13). The server reads this variable AS
#     the secret, so `none` does not turn authentication off: it installs
#     a live door key whose value is that word, admitting anyone who sends
#     it and carrying no identity. Leave it EMPTY in dev; set a real
#     secret in production. An earlier version of this file said `none`
#     was allowed for all three. It was wrong.
SESSION_TOKEN_PRIVATE_KEY_B64=
MCP_BEARER=
# OPSROOM_BACKUP_DEST — see backups above (s3://<bucket>, or none)

# ── file storage: a SECOND bucket with its OWN token (D3/D7) ─────────
# Where uploaded files live. NOT the backup bucket and NOT the backup
# token: backups are pruned on a timer and uploaded files never are, and
# the backup's mirror of this bucket would otherwise copy a bucket into
# itself. The backup token may READ this bucket; this token must not be
# able to touch the backups. Region is `auto` for R2, a real region for
# AWS, ignored by MinIO. A production instance refuses to boot without
# the first four — an instance that cannot store a file cannot take an
# upload, and there is no path-shaped fallback to pretend with.
OPSROOM_OBJECT_STORE_BASE=
OPSROOM_OBJECT_STORE_ENDPOINT=
OPSROOM_OBJECT_STORE_ACCESS_KEY_ID=
OPSROOM_OBJECT_STORE_SECRET_ACCESS_KEY=
OPSROOM_OBJECT_STORE_REGION=auto

# ── instance identity (board 150, D1) ────────────────────────────────
# The domain package this instance runs, pinned like the image tag.
# Omit the line entirely for a blank instance (the form's `none`).
OPSROOM_DISTRO=healthcare@0.1

# ── misc ─────────────────────────────────────────────────────────────
VECTOR_LOG_LEVEL=info
