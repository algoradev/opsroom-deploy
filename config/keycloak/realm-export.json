{
  "realm": "asunset",
  "enabled": true,
  "displayName": "Asunset",
  "displayNameHtml": "<b>Asunset</b>",
  "loginTheme": "asunset",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "verifyEmail": false,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 14400,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "passwordPolicy": "length(12) and notUsername and notEmail and upperCase(1) and digits(1) and specialChars(1)",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "TOKEN_EXCHANGE",
    "TOKEN_EXCHANGE_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_PASSWORD",
    "UPDATE_PASSWORD_ERROR",
    "REMOVE_TOTP",
    "REVOKE_GRANT",
    "VERIFY_EMAIL",
    "REGISTER",
    "REGISTER_ERROR",
    "SEND_RESET_PASSWORD",
    "SEND_VERIFY_EMAIL",
    "UPDATE_EMAIL",
    "UPDATE_PROFILE",
    "UPDATE_TOTP",
    "IMPERSONATE"
  ],
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Operates the instance: manages orgs/teams, Keycloak config, OpenFGA store. Not a per-org role.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "platform_support",
        "description": "Read-only observability on the instance. May have user-impersonation rights per operator policy.",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": [
    "offline_access",
    "uma_authorization"
  ],
  "clients": [
    {
      "clientId": "asunset-api",
      "name": "Asunset API",
      "description": "Confidential server-side client for the FastAPI resource server.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "asunset-web",
      "name": "Asunset Web",
      "description": "Public SPA client. PKCE required, standard auth code flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*",
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "asunset-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-asunset-api",
      "enabled": true,
      "serviceAccountClientId": "asunset-api",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users"
        ]
      }
    }
  ]
}